# Example local overrides. Omit a variable to use its documented default.
# Production should use same-origin serving or explicit trusted origins.
CODESTRUCT_ENV=development
# Use alias=path entries separated by the OS path separator.
CODESTRUCT_AUTHORIZED_ROOTS=team=D:\path\to\authorized\project
CODESTRUCT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CODESTRUCT_MAX_CONCURRENT_JOBS=2
CODESTRUCT_MAX_QUEUED_JOBS=8
CODESTRUCT_ANALYSIS_TIMEOUT_SECONDS=120
CODESTRUCT_CANCELLATION_GRACE_SECONDS=3
CODESTRUCT_RESULT_RETENTION_SECONDS=900
CODESTRUCT_POLLING_INTERVAL_MS=750
CODESTRUCT_MAX_DEPTH=40
CODESTRUCT_MAX_FILES=10000
CODESTRUCT_MAX_FILE_SIZE=2097152
# This repository-local database override is for development; packaged defaults
# use the platform user-data directory.
CODESTRUCT_DATABASE_PATH=.codestruct/runtime/codestruct.sqlite3
CODESTRUCT_MAX_CACHE_RESULTS=100
CODESTRUCT_MAX_CACHE_BYTES=268435456
CODESTRUCT_MAX_FULL_GRAPH_BYTES=4194304
CODESTRUCT_MAX_GRAPH_PAGE_SIZE=1000

# Leave empty to use the Vite development proxy or a production same-origin API.
VITE_CODESTRUCT_API_URL=
